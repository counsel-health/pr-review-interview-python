# Where the embedded PostgreSQL server keeps its data directory, relative to
# backend/. Defaults to .pgdata/
# Override only if you want to keep multiple databases side by side.
# PGDATA_DIR=.pgdata

# Point the backend at an external PostgreSQL instead of the embedded one.
# When set, the embedded server is never started and `uv run db-reset`
# refuses to run.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/counsel

# Set to 0 to stop the API server from running a job worker in its lifespan.
# Do that when running `uv run run-worker` in its own process, or the two
# workers compete for the same jobs.
# RUN_WORKER=1

# Where the Next.js dev server proxies /api/* requests. Defaults to
# http://localhost:8000
# BACKEND_URL=http://localhost:8000

# Shared secret for Relay webhook signatures. Outbound payloads are signed
# with it; inbound webhooks are verified against it.
RELAY_WEBHOOK_SECRET=dev-secret
